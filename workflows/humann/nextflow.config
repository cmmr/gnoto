// Resource requests and process fixes for workflows/humann/main.nf, auto-loaded
// by nextflow from the workflow's own directory. The executor, resource caps
// and image cache come from the site's config, as they do for
// nf-core/taxprofiler, and -profile apptainer runs each task in its container.
// Databases are read over the shared filesystem through the symlinks Nextflow
// stages them as.

process {
    // A private TMPDIR per task, in the scratch directory Nextflow creates on
    // the node and removes when the task exits
    scratch      = true
    beforeScript = 'export TMPDIR=$NXF_SCRATCH'

    // Translated search is what this reservation is for. bowtie2 against the
    // sample's own pangenome database is small; DIAMOND then sends whatever did
    // not map against the 34 GB UniRef90 index, and on a stool sample that is
    // most of the reads. HUMAnN is left on its default --memory-use minimum, so
    // DIAMOND blocks the index rather than holding it whole.
    //
    // A whole node for up to 48 hours: 526 million reads spent 19 hours in
    // DIAMOND alone on 16 cpus. The site's time cap has to allow 48 hours. A
    // sample is not retried, and one that does not finish is ignored, so
    // HUMANN_TABLES builds from whatever finished. Which samples those were is
    // in humann/alignment-summary.tsv.
    //
    // HUMAnN decompresses a sample's reads into its temporary folder and writes
    // bowtie2's alignments of every one of them beside it, about four times the
    // sample's uncompressed size at once. That is more than a node's /tmp has
    // free for a deep sample, so it runs in its work directory on the shared
    // filesystem.
    withName: 'HUMANN_PROFILE' {
        cpus          = 32
        memory        = 900.GB
        time          = 48.h
        errorStrategy = 'ignore'
        scratch       = false
        beforeScript  = 'export TMPDIR=$PWD'
    }

    // Joining reads every sample's gene family table into memory at once, and a
    // WGS sample carries hundreds of thousands of UniRef90 rows.
    //
    // Retried rather than left to terminate: this is the one task standing
    // between every sample's profile and the published tables, and it is as
    // exposed to transient read errors as the steps
    // conf/taxprofiler/resources.config retries.
    withName: 'HUMANN_TABLES' {
        cpus          = 2
        memory        = 64.GB
        time          = 8.h
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
}

profiles {
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
}
