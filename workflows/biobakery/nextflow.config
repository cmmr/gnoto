// Defaults for workflows/biobakery, auto-loaded by nextflow from the workflow's
// own directory. Nothing here is specific to a host: the executor, resource
// caps and container settings come from the site's config, the larger requests
// from pipelines/biobakery/resources.config, and every database from a
// parameter.

manifest {
    name            = 'biobakery'
    description     = 'KneadData, MetaPhlAn, HUMAnN, mOTUs, Nonpareil, EsViritu and Marker-MAGu over shotgun metagenomes'
    nextflowVersion = '>=24.04.0'
}

params {
    input  = null
    outdir = null

    // Optional modules; KneadData and MetaPhlAn always run. EsViritu is off
    // unless asked for.
    run_humann     = true
    run_motus      = true
    run_nonpareil  = true
    run_esviritu   = false
    run_markermagu = true

    // Host depletion, ahead of KneadData, against kneaddata_db: a directory
    // holding one bowtie2 index, or empty to deplete nothing. bowtie2 runs end
    // to end with the first options, then with the second over the pairs the
    // first pass left.
    kneaddata_db                   = null
    host_prefilter_bowtie2_options = '--fast'
    host_bowtie2_options           = '--very-sensitive-local'

    // KneadData's trimming and tandem repeat removal
    kneaddata_sequencer_source = 'NexteraPE'
    kneaddata_args             = ''

    // The folders the host-depleted and the cleaned reads are published to;
    // null publishes that set nowhere
    host_depleted_outdir = null
    cleaned_outdir       = null

    // MetaPhlAn: a directory holding one database release
    metaphlan_db   = null
    metaphlan_args = ''

    // HUMAnN's three database directories
    humann_chocophlan      = null
    humann_uniref          = null
    humann_utility_mapping = null

    // mOTUs: the db_mOTU directory of a database matching mOTUs 3.1.0
    motus_db   = null
    motus_args = ''

    // Nonpareil: kmer or alignment
    nonpareil_mode = 'kmer'
    nonpareil_args = ''

    // EsViritu: a database directory of v3.1.0 or later, holding
    // virus_pathogen_database.fna and its metadata
    esviritu_db   = null
    esviritu_args = ''

    // Marker-MAGu: a database directory holding Marker-MAGu_markerDB.fna.
    // Detection is default (75% of an SGB's markers) or relaxed (33.3%).
    markermagu_db        = null
    markermagu_detection = 'default'
    markermagu_args      = ''
}

includeConfig 'conf/base.config'

profiles {
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    local {
        process.executor       = 'local'
        process.resourceLimits = [ cpus: Runtime.runtime.availableProcessors(), memory: 16.GB, time: 24.h ]
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: '.'}/pipeline_info/timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: '.'}/pipeline_info/report.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: '.'}/pipeline_info/trace.txt"
}
