// Resource requests and process fixes for nf-core/ampliseq, passed with -c. The
// executor, resource caps, container settings and image cache come from the
// site's config.

process {
    // Point TMPDIR at the per-task scratch directory, which Nextflow creates on
    // the node's /tmp and removes when the task exits. Without this, QIIME 2's
    // cache at $TMPDIR/qiime2/$USER is one directory shared by every task on the
    // node, and its garbage collection deletes the process pools of tasks still
    // writing to them: apptainer runs each container in its own PID namespace,
    // so the pools of concurrent tasks read as belonging to dead processes.
    scratch      = true
    beforeScript = 'export TMPDIR=$NXF_SCRATCH'

    // Phylogenetic placement, against a reference of 54322 sequences in ~1550
    // alignment columns. ampliseq's labels size both of these for a reference a
    // fraction of that: CLUSTALO_ALIGN is process_medium (6 CPUs, 6 GB, 8 h),
    // and EPANG_PLACE carries only process_medium_memory, so it inherits the
    // pipeline default of one CPU and one hour to place onto a 54322-tip tree.
    withName: 'CLUSTALO_ALIGN' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: 'EPANG_PLACE' {
        cpus   = 16
        memory = { 128.GB * task.attempt }
        time   = { 12.h   * task.attempt }
    }

    // QIIME2_DIVERSITY_ALPHA tests whether alpha diversity differs between
    // groups of samples. A request with no metadata has no groups: the sheet
    // ampliseq_samplesheet.sh writes carries only the sequencing run, one value
    // for every sample off a single run, and QIIME2 treats a column of one value
    // as an error. ampliseq runs this against the metadata file itself, so no
    // upstream switch turns it off. Ignored rather than skipped, because a
    // request spanning two sequencing runs has a real batch variable to test.
    withName: 'QIIME2_DIVERSITY_ALPHA' {
        errorStrategy = 'ignore'
    }

    // ampliseq's Barrnap rejects a hit under 10% of the gene, and with
    // filter_ssu set, stops the run when no ASV is left. That suits paired
    // reads that merge, the usual run. Other ASVs can be shorter: a single-end
    // run's of about 150 bp align 9% of 16S, so every one was rejected. For
    // those runs, 5% keeps ASVs down to about 75 bp.
    withName: 'BARRNAP' {
        ext.args = {
            params.sequencing_type == 'illumina_pe' && params.mergepairs_strategy == 'merge'
                ? '--quiet --reject 0.1' : '--quiet --reject 0.05'
        }
    }
}
