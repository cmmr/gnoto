{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFrontReads",
      "Effect": "Allow",
      "Principal": {"Service": "cloudfront.amazonaws.com"},
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<bucket>/*",
      "Condition": {"StringEquals": {"AWS:SourceArn": "arn:aws:cloudfront::<account>:distribution/<distribution>"}}
    }
  ]
}
