{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListRuns",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<bucket>",
      "Condition": {"StringLike": {"s3:prefix": ["<run_prefix>/*"]}}
    },
    {
      "Sid": "WriteRuns",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::<bucket>/<run_prefix>/*"
    }
  ]
}
