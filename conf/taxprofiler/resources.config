// Resource requests and process fixes for nf-core/taxprofiler, passed with -c.
// The executor, resource caps, container settings and image cache come from the
// site's config.
//
// Sized on nodes with 32 cores and 1 TB of RAM, with node-local NVMe under
// /tmp. Databases are read over the shared filesystem through the symlink
// Nextflow stages them as; nothing copies them.

process {
    // Point TMPDIR at the per-task scratch directory, which Nextflow creates on
    // the node's /tmp and removes when the task exits. Without this, a tool that
    // caches under $TMPDIR writes to one directory shared by every task on the
    // node, and concurrent tasks delete each other's files: apptainer runs each
    // container in its own PID namespace, so anything keyed on a pid collides.
    scratch      = true
    beforeScript = 'export TMPDIR=$NXF_SCRATCH'

    // kraken2 reads hash.k2d into its own heap: 110 GB for pluspf_20260626, plus
    // the read batch. Two of these fit a 1 TB node, and 16 cpus puts two there
    // anyway. Re-check this against the size of hash.k2d after a database
    // update.
    withName: 'KRAKEN2_KRAKEN2' {
        cpus   = 16
        memory = 128.GB
    }

    // Host depletion aligns against one host genome plus PhiX, 3.1 Gbp at most,
    // so a small (.bt2) index of roughly 4 GB. 16 GB was not enough: a task
    // peaked at 16.8 GiB.
    withName: 'BOWTIE2_ALIGN' {
        cpus   = 16
        memory = 24.GB
    }

    // bowtie2 against the 22 GB marker index, and usually the longest step
    withName: 'METAPHLAN_METAPHLAN' {
        cpus   = 16
        memory = 48.GB
    }

    // mOTUs maps against the marker gene catalogue with bwa, a 3.5 GB index it
    // holds in memory alongside the read batch
    withName: 'MOTUS_PROFILE' {
        cpus   = 16
        memory = 32.GB
    }

    // The module passes task.memory to Nonpareil's -R, and k-mer mode fills it
    // with the k-mer table it builds over the reads. Too small a reservation
    // gives a coarser estimate rather than a failure, but 3 Gbp of R1 wants room.
    //
    // A sample it cannot measure is left out of the diversity table rather than
    // failing the run: nothing downstream consumes its output, and the pages plot
    // whichever samples it managed. pipelines/taxprofiler/pipeline.sh sets the
    // read length that keeps it from failing in the first place. Retried before
    // it is ignored, so a sample lost to a transient read error is not silently
    // missing.
    withName: 'NONPAREIL_NONPAREIL' {
        cpus          = 8
        memory        = 64.GB
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
    }

    // The steps that read the requester's own FASTQ files, retried on any
    // failure rather than on the exit codes alone.
    //
    // taxprofiler_samplesheet.sh symlinks already-gzipped input rather than
    // copying it, so these read from wherever the sequencing centre left the
    // data. Reads there have failed transiently, with "java.io.IOException:
    // Operation not permitted" on files that read back clean straight after,
    // across nodes and file sizes. nf-core's strategy retries only a few signal
    // and system exit codes, and FastQC returns 1 for an I/O error, which
    // stopped the whole run. "finish" once the retries are spent, as
    // taxprofiler's base config does, so the tasks already running can land.
    withName: 'FASTQC|FASTQC_PROCESSED|FASTP_SINGLE|FASTP_PAIRED' {
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    // taxpasta 0.7.0 cannot merge MetaPhlAn profiles carrying two clades that
    // share one NCBI taxon id, which mpa_vJun23 has. Its merge is allowed to
    // fail; the kraken2 and bracken ones still have to pass, and so does any
    // MetaPhlAn merge whose tag cannot be read.
    withName: 'TAXPASTA_MERGE' {
        errorStrategy = { task.tag?.toString()?.startsWith('metaphlan') ? 'ignore' : 'terminate' }
    }
}
