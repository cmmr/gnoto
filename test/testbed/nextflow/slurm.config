// slurm.config - Runs every task through Slurm and Apptainer in the test bed.
process {
    executor = 'slurm'
    // The node has 6 CPUs and 24 GB, and a head job holds 1 CPU and 4 GB
    resourceLimits = [cpus: 4, memory: 18.GB, time: 4.h]
}

executor {
    queueStatInterval = '10s'
    pollInterval = '5s'
}

apptainer {
    enabled = true
    autoMounts = true
}
