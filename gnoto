#!/bin/sh
#
# gnoto - The gnoto launcher: runs a gnoto command inside the gnoto image.
#
# Run by:    people, Slurm (each job runs it through sbatch --wrap), itself
#            (for jobs that run on this machine), and the systemd units
# Usage:     gnoto <command> [arguments]
# Requires:  POSIX sh, awk, mktemp, mkfifo, flock, nohup and Apptainer on the
#            host, and setsid where it has one
#
# Before the image can start, it needs eight settings, which it reads from
# config.yaml with its own awk: core.data_dir, core.db_dir, and apptainer's and
# slurm's enabled and bin_dir, apptainer.binds and slurm.conf. Only lines
# written as   key: "value",   key: true   or   key: false   under their section
# count. config.yaml is optional: without it, or for a setting it leaves unset,
# the data directory is <install>/data, and Apptainer and Slurm come from PATH.
# Slurm's settings count only when slurm.enabled is true. gnoto config writes
# config.yaml, in the image.
#
# gnoto init --apptainer=<path> runs here alone, before Apptainer can be found:
# it writes a config.yaml holding only an apptainer section that says where it
# is, for a machine where Apptainer isn't on PATH, and refuses if there's a
# config.yaml already.
#
# It finds or pulls the image IMAGE names, starts host/helper.sh on a FIFO in a
# private directory, and runs lib/main.sh in the image with --cleanenv. Inside,
# a stand-in for each command in host/allowed/ comes first on PATH and passes
# calls to the helper. Without Slurm, gnoto start queues its job in the private
# directory, and this starts it once the image has exited, detached, as
# another run of this launcher.
#
# SIGTERM, SIGINT and SIGHUP are passed to Apptainer as SIGTERM, and the helper
# keeps running until Apptainer exits, because Nextflow cancels its tasks
# through the scancel stand-in as it shuts down.

set -eu
umask 002

die() {
    printf 'gnoto: %s\n' "$*" >&2
    exit 1
}

SELF=$(readlink -f -- "$0" 2> /dev/null) || SELF=$0
CODE_DIR=$(cd -P -- "$(dirname -- "$SELF")" && pwd -P)
INSTALL_DIR=$CODE_DIR
CONFIG=$INSTALL_DIR/config.yaml

# Prints <section>.<key> from config.yaml, or nothing if it's unset. Exits 2 if
# the key is there but not written as   key: "value",   key: true   or
#   key: false
bootstrap_setting() {
    awk -v section="$1" -v key="$2" '
        /^[^ #]/ { here = ($0 ~ ("^" section ":[ ]*(#.*)?$")); next }
        !here || index($0, "  " key ":") != 1 { next }
        {
            rest = substr($0, length(key) + 4)
            if (rest ~ /^ +(true|false)[ ]*(#.*)?$/) {
                sub(/^ +/, "", rest)
                sub(/[ ]*(#.*)?$/, "", rest)
                print rest
                exit
            }
            prefix = "  " key ": \""
            if (index($0, prefix) != 1) { bad = 1; exit }
            rest = substr($0, length(prefix) + 1)
            end = index(rest, "\"")
            if (end == 0 || substr(rest, end + 1) !~ /^[ ]*(#.*)?$/) { bad = 1; exit }
            print substr(rest, 1, end - 1)
            exit
        }
        END { if (bad) exit 2 }
    ' "$CONFIG"
}

# gnoto init: writes config.yaml with where the container engine is. Apptainer
# is the only engine so far.
init() {
    ENGINE=
    ENGINE_PATH=
    for OPTION in "$@"; do
        case $OPTION in
            --apptainer=?*) ENGINE=apptainer; ENGINE_PATH=${OPTION#*=} ;;
            *) die "gnoto init takes --apptainer=/path/to/apptainer, not $OPTION" ;;
        esac
    done
    [ -n "$ENGINE" ] || die "Usage: gnoto init --apptainer=/path/to/apptainer"
    [ ! -e "$CONFIG" ] || die "$CONFIG already exists. Edit it by hand, or run gnoto config."

    case $ENGINE_PATH in /*) ;; *) ENGINE_PATH=$PWD/$ENGINE_PATH ;; esac
    ENGINE_DIR=${ENGINE_PATH%/}
    [ -d "$ENGINE_DIR" ] || ENGINE_DIR=${ENGINE_DIR%/*}
    [ -f "$ENGINE_DIR/$ENGINE" ] && [ -x "$ENGINE_DIR/$ENGINE" ] ||
        die "there's no $ENGINE command at $ENGINE_PATH"
    case $ENGINE_DIR in *'"'*) die "a path with a double quote can't go in config.yaml: $ENGINE_DIR" ;; esac

    (set -C; printf '%s\n' "# This install's settings. gnoto config lists the sections, and adds or changes one." \
        "" "$ENGINE:" "  enabled: true" "  bin_dir: \"$ENGINE_DIR\"" > "$CONFIG") 2> /dev/null ||
        die "can't write $CONFIG"
    chgrp "$(id -g)" "$CONFIG" && chmod 660 "$CONFIG" || die "can't set the group and mode of $CONFIG"
    printf 'Wrote %s, with %s.bin_dir "%s". gnoto config lists the other sections.\n' \
        "$CONFIG" "$ENGINE" "$ENGINE_DIR"
}

if [ "${1:-}" = init ]; then
    shift
    init "$@"
    exit 0
fi

BOOTSTRAP=
DATA_DIR=$INSTALL_DIR/data
DB_DIR=
APPTAINER_ENABLED=
APPTAINER_BIN_DIR=
BINDS=
SLURM_ENABLED=
SLURM_BIN_DIR=
SLURM_CONF_SETTING=
if [ -e "$CONFIG" ]; then
    [ -r "$CONFIG" ] || die "can't read $CONFIG"
    for SETTING in core.data_dir core.db_dir apptainer.enabled apptainer.bin_dir apptainer.binds \
        slurm.enabled slurm.bin_dir slurm.conf; do
        VALUE=$(bootstrap_setting "${SETTING%%.*}" "${SETTING#*.}") ||
            die "config.yaml: write $SETTING as   ${SETTING#*.}: \"value\"   under ${SETTING%%.*}:, with the value in double quotes, or true or false"
        case $SETTING in
            core.data_dir) DATA_DIR=${VALUE:-$INSTALL_DIR/data} ;;
            core.db_dir) DB_DIR=$VALUE ;;
            apptainer.enabled) APPTAINER_ENABLED=$VALUE ;;
            apptainer.bin_dir) APPTAINER_BIN_DIR=$VALUE ;;
            apptainer.binds) BINDS=$VALUE ;;
            slurm.enabled) SLURM_ENABLED=$VALUE ;;
            slurm.bin_dir) SLURM_BIN_DIR=$VALUE ;;
            slurm.conf) SLURM_CONF_SETTING=$VALUE ;;
        esac
        BOOTSTRAP="$BOOTSTRAP$SETTING=$VALUE
"
    done
fi
DB_DIR=${DB_DIR:-$DATA_DIR/db}
[ "$APPTAINER_ENABLED" != false ] ||
    die "apptainer.enabled is false in $CONFIG, and gnoto has no other container engine yet. Set it to true."
if [ "$SLURM_ENABLED" != true ]; then
    SLURM_BIN_DIR=
    SLURM_CONF_SETTING=
fi

# The helper runs host commands with this PATH and SLURM_CONF, so they don't
# depend on what the caller's shell has loaded
for DIR in "$SLURM_BIN_DIR" "$APPTAINER_BIN_DIR"; do
    if [ -n "$DIR" ]; then
        PATH=$DIR:$PATH
    fi
done
export PATH
if [ -n "$SLURM_CONF_SETTING" ]; then
    SLURM_CONF=$SLURM_CONF_SETTING
    export SLURM_CONF
fi
if ! APPTAINER=$(command -v apptainer); then
    [ -e "$CONFIG" ] || die "can't find apptainer. Put its directory on PATH, or run: gnoto init --apptainer=/path/to/apptainer"
    die "can't find apptainer. Put its directory on PATH, or set apptainer.bin_dir in $CONFIG."
fi
SBATCH=$(command -v sbatch) || SBATCH=

mkdir -p "$DATA_DIR/images" "$DB_DIR" ||
    die "can't create $DATA_DIR/images and $DB_DIR"

BASE=${TMPDIR:-/tmp}
[ -d "$BASE" ] || BASE=/tmp

# Apptainer's layer cache can't be shared between users, so it's per user and
# on node-local storage, as is the space it builds a .sif in, which /tmp may be
# too small for. Only finished .sif files go in <data_dir>/images.
APPTAINER_CACHEDIR=$BASE/gnoto-apptainer-$(id -u)/cache
APPTAINER_TMPDIR=$BASE/gnoto-apptainer-$(id -u)/tmp
export APPTAINER_CACHEDIR APPTAINER_TMPDIR
mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR" ||
    die "can't create $APPTAINER_CACHEDIR and $APPTAINER_TMPDIR"

# Pulls an image to a temporary name under a lock, then renames it
pull_image() {
    (
        flock 9 || exit 1
        [ -f "$2" ] && exit 0
        rm -f "$2.tmp"
        apptainer pull "$2.tmp" "$1" >&2 || exit 1
        mv -f "$2.tmp" "$2"
    ) 9> "$2.lock" || die "can't pull the gnoto image $1"
}

IMAGE=
IFS= read -r IMAGE < "$CODE_DIR/IMAGE" || [ -n "$IMAGE" ] || die "can't read $CODE_DIR/IMAGE"
case $IMAGE in
    docker://*@sha256:*)
        NAME=${IMAGE#docker://}
        NAME=${NAME%%@*}
        NAME=${NAME##*/}
        SIF=$DATA_DIR/images/$NAME-${IMAGE##*@sha256:}.sif
        [ -f "$SIF" ] || pull_image "$IMAGE" "$SIF"
        ;;
    */* | .*) die "IMAGE must name docker://<image>@sha256:<digest>, or a .sif in $DATA_DIR/images" ;;
    *.sif)
        SIF=$DATA_DIR/images/$IMAGE
        [ -f "$SIF" ] || die "the gnoto image $SIF is missing"
        ;;
    *) die "IMAGE must name docker://<image>@sha256:<digest>, or a .sif in $DATA_DIR/images" ;;
esac

# A FIFO only works within one machine, so this is node-local
PRIVATE=$(mktemp -d "$BASE/gnoto.XXXXXX") || die "can't make a directory in $BASE"
HELPER_PID=

cleanup() {
    if [ -n "$HELPER_PID" ]; then
        kill -KILL "$HELPER_PID" 2> /dev/null || :
        wait "$HELPER_PID" 2> /dev/null || :
    fi
    rm -rf "$PRIVATE"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir "$PRIVATE/bin" "$PRIVATE/req"
mkfifo "$PRIVATE/requests"
for LIST in "$CODE_DIR"/host/allowed/*; do
    while IFS= read -r NAME || [ -n "$NAME" ]; do
        case $NAME in
            '' | '#'*) continue ;;
            *[!a-z0-9_-]*) die "bad command name in $LIST: $NAME" ;;
        esac
        ln -s "$CODE_DIR/host/standin.sh" "$PRIVATE/bin/$NAME"
    done < "$LIST"
done

# Only what's set here reaches the image. APPTAINERENV_ variables survive
# --cleanenv, so any the caller set are dropped first.
for VAR in $(env | sed -n -e 's/^\(APPTAINERENV_[A-Za-z0-9_]*\)=.*/\1/p' \
    -e 's/^\(SINGULARITYENV_[A-Za-z0-9_]*\)=.*/\1/p'); do
    unset "$VAR"
done
APPTAINERENV_PREPEND_PATH=$PRIVATE/bin
APPTAINERENV_GNOTO_CODE_DIR=$CODE_DIR
APPTAINERENV_GNOTO_INSTALL_DIR=$INSTALL_DIR
APPTAINERENV_GNOTO_DATA_DIR=$DATA_DIR
APPTAINERENV_GNOTO_DB_DIR=$DB_DIR
APPTAINERENV_GNOTO_HELPER_DIR=$PRIVATE
APPTAINERENV_USER=$(id -un)
export APPTAINERENV_PREPEND_PATH APPTAINERENV_GNOTO_CODE_DIR APPTAINERENV_GNOTO_INSTALL_DIR \
    APPTAINERENV_GNOTO_DATA_DIR APPTAINERENV_GNOTO_DB_DIR APPTAINERENV_GNOTO_HELPER_DIR \
    APPTAINERENV_USER
if [ -n "${TERM-}" ]; then
    export APPTAINERENV_TERM="$TERM"
fi
for VAR in SLURM_JOB_ID SLURM_CPUS_PER_TASK SLURM_CPUS_ON_NODE SLURMD_NODENAME; do
    eval "VALUE=\${$VAR-}"
    if [ -n "$VALUE" ]; then
        export "APPTAINERENV_$VAR=$VALUE"
    fi
done

# What this read from config.yaml, which gnoto lint checks yq agrees with
export APPTAINERENV_GNOTO_BOOTSTRAP="$BOOTSTRAP"

# What's in effect here, which gnoto config suggests when it writes config.yaml
export APPTAINERENV_GNOTO_FOUND_APPTAINER_BIN_DIR="${APPTAINER%/*}"
if [ -n "$SBATCH" ]; then
    export APPTAINERENV_GNOTO_FOUND_SLURM_BIN_DIR="${SBATCH%/*}"
fi
if [ -n "${SLURM_CONF-}" ]; then
    export APPTAINERENV_GNOTO_FOUND_SLURM_CONF="$SLURM_CONF"
fi

sh "$CODE_DIR/host/helper.sh" "$PRIVATE" < /dev/null &
HELPER_PID=$!

# Every path is bound at its host path, so a path means the same inside and out
set -- "$SIF" /bin/bash "$CODE_DIR/lib/main.sh" "$@"
if [ -n "$BINDS" ]; then
    set -- -B "$BINDS" "$@"
fi
set -- exec --cleanenv -B "$CODE_DIR" -B "$DATA_DIR" -B "$DB_DIR" -B "$PRIVATE" "$@"

# In the background, so a signal can be passed on while it runs. An
# asynchronous command reads /dev/null unless told otherwise.
if (exec 4<&0) 2> /dev/null; then
    exec 4<&0
else
    exec 4< /dev/null
fi
apptainer "$@" <&4 4<&- &
CHILD_PID=$!
exec 4<&-

trap 'kill -TERM "$CHILD_PID" 2> /dev/null || :' HUP INT TERM

while :; do
    STATUS=0
    wait "$CHILD_PID" || STATUS=$?
    kill -0 "$CHILD_PID" 2> /dev/null || break
done

# Jobs that run on this machine, queued by lib/scheduler.sh as
# "<directory><tab><log><tab><gnoto arguments>", start here, once the image has
# exited, each detached from this session so it outlives it
if [ "$STATUS" -eq 0 ] && [ -s "$PRIVATE/detach" ]; then
    TAB=$(printf '\t')
    while IFS=$TAB read -r DIR LOG ARGS; do
        case $DIR in
            "$DATA_DIR"/*) ;;
            *) die "won't start a job outside $DATA_DIR: $DIR" ;;
        esac
        case $ARGS in
            _local\ * | _fetch\ *) ;;
            *) die "won't start \"$ARGS\" as a job" ;;
        esac
        if command -v setsid > /dev/null 2>&1; then
            # shellcheck disable=SC2086
            (cd "$DIR" && exec setsid nohup "$SELF" $ARGS > "$LOG" 2>&1 < /dev/null &)
        else
            # shellcheck disable=SC2086
            (cd "$DIR" && exec nohup "$SELF" $ARGS > "$LOG" 2>&1 < /dev/null &)
        fi
    done < "$PRIVATE/detach"
fi
exit "$STATUS"
